root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
trim_trailing_whitespace = true

[*.{cs,csproj,props,targets,slnx}]
indent_size = 4

[*.{yml,yaml,json,md,sh}]
indent_size = 2

[*.ps1]
indent_size = 4
end_of_line = crlf

[*.cs]
dotnet_sort_system_directives_first = true
csharp_new_line_before_open_brace = all

# The whole public API lives in the LabTesting namespace, whatever subdirectory a
# file sits in. Renaming to match the folders would break every consumer's usings.
dotnet_style_namespace_match_folder = false
resharper_check_namespace_highlighting = none
